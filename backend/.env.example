NODE_ENV=development
PORT=5000

# Usa un usuario de MongoDB exclusivo para esta aplicación, nunca una cuenta administradora.
MONGODB_URI=mongodb://localhost:27017/mantenimiento

# Genera un valor aleatorio de al menos 32 caracteres y no lo subas a Git.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
JWT_ISSUER=mantenimiento-industrial-api
JWT_AUDIENCE=mantenimiento-industrial-web

# Lista separada por comas. En producción agrega la URL exacta del frontend.
CORS_ORIGINS=http://localhost:3000

# Opcionales. En Railway, RAILWAY_PUBLIC_DOMAIN se incorpora automáticamente.
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY=0
ENFORCE_HTTPS=false

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
AUTH_ACCOUNT_RATE_LIMIT_MAX=5
JSON_BODY_LIMIT=20kb

# Mantener en false: los administradores crean las cuentas desde la aplicación.
ALLOW_PUBLIC_REGISTRATION=false

# No definir en producción. Habilita manualmente seed/cleanup solo en una BD desechable.
ALLOW_DESTRUCTIVE_DB_TASKS=false
